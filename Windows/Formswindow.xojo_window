#tag EndWindowCode

#tag Events Bouton
	#tag Event
		Sub MouseEnter(index as Integer)
		  if  not selection and kit = 0 then
		    workwindow.selectedtool = fam
		    reset(index)
		  end if
		  
		End Sub
	#tag EndEvent
	#tag Event
		Sub Action(index as Integer)
		  if  selection then
		    if index =0 then
		      Config.ToggleFLib(fam)
		    else
		      Config.ToggleLibVisible(fam,index-1)
		    end if
		    RefreshContent
		    WorkWindow.LibBoxRefresh
		  else
		    dim Op As Operation
		    if CurrentContent = nil then
		      Visible = False
		      Return
		    end if
		    Op = CurrentContent.CurrentOperation
		    
		    if Op isa ShapeConstruction and Op.currentshape <> nil  and op.finished = false then
		      CurrentContent.abortconstruction
		    end if
		    
		    if kit = 0 then
		      Op=new ShapeConstruction(10 + fam,index)
		      Workwindow.drapico = false
		    else
		      if (fam = 1) and ( index mod 3 <>  0 ) and (index < 6)  then
		        Op = new ParaPerpConstruction (fam, index)
		      else
		        Op=new ShapeConstruction(fam,index)
		      end if
		    end if
		    if CurrentContent.TheObjects <> nil then
		      CurrentContent.TheObjects.unselectAll
		    end if
		    CurrentContent.CurrentOperation  = Op
		    WorkWindow.refreshtitle
		    Visible = False
		    if WorkWindow.MyCanvas1 <> nil then
		      WorkWindow.MyCanvas1.SetFocus
		    end if
		  end if
		End Sub
	#tag EndEvent
	#tag Event
		Sub Open(index as Integer)
		  
		  
		End Sub
	#tag EndEvent
	#tag Event
		Function MouseUp(index as Integer, X As Integer, Y As Integer) As Boolean
		  return false
		End Function
	#tag EndEvent
	#tag Event
		Function MouseDown(index as Integer, X As Integer, Y As Integer) As Boolean
		  return false
		End Function
	#tag EndEvent
#tag EndEvents
